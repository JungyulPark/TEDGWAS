# =============================================================
# TED-TRAP v5 .gitignore — updated 2026-05-30
# =============================================================

# ---- Environment / IDE ----
.venv/
.env
.Renviron
__pycache__/
.Rhistory
.RData

# ---- Large binary data (exceed GitHub 100 MB limit) ----
*.gz
finngen_R12_*.gz
data.txt

# ---- PLINK genetic references and raw outputs ----
*.bed
*.bim
*.fam
*.synonyms
*.frq
*.ld
*.log

# ---- Exclude data directories containing massive reference files ----
TrackA_MR/archives/
TrackA_MR/v5_upgrade/data/
TrackA_MR/v5_upgrade/02_tshr_finemap/data/
TrackA_MR/v5_upgrade/04_druggable_mr/data/

# ---- Binary tools (should not be in repo) ----
tools/
gcta-1.95.1-windows-x86_64.zip
plink_test.zip
plink_win64_20250819.zip

# ---- Temporary extraction / zip directories ----
temp_zip/
temp_zip_4/
temp_zip_5/
temp_zip_6/
temp_extracted_4/
temp_extracted_5/
temp_extracted_6/
v5_handoff_temp/
v5_handoff_parallel/
v5_handoff_parallel_10/

# ---- Document binaries (Word/Excel/PDF) ----
*.docx
*.xlsx
*.pdf
# Exception: track the final JEI submission deliverables
!MANUSCRIPT_TED_TRAP_v5_SUBMISSION.docx
!COVER_LETTER_JEI.docx

# ---- Image binaries (figures tracked separately in v5_upgrade/07_manuscript/figures) ----
*.png
*.tiff
*.jpg
!TrackA_MR/v5_upgrade/**/*.png

# ---- Archive of stale manuscripts ----
_ARCHIVE_STALE/

# ---- Misc temp/diagnostic files ----
test_ld.ld
test_ld.log
test_extract.txt
docs_dump.txt

# ---- Uploaded zip handoffs (already extracted) ----
files (*.zip
files*.zip
!submission/figures/*.png
!KSO_oral_abstract_KR_EN.docx
